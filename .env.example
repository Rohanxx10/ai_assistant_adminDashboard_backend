# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Storage bucket name for UPI screenshots (create this bucket, public)
SUPABASE_STORAGE_BUCKET=upi-screenshots

# JWT secrets (use long random strings in production)
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_string

# Token expiry
JWT_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call this API
# e.g. https://your-admin-dashboard.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# One-time setup guard: set to a secret string, used to create the first admin account
FIRST_ADMIN_SETUP_KEY=some_secret_only_you_know

PORT=4000
